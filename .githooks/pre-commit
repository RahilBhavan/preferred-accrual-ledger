#!/usr/bin/env python3
"""Reject staged files over 5,000 estimated tokens; inspect index bytes, not working tree."""
import subprocess
import sys

paths = subprocess.check_output(['git', 'diff', '--cached', '--name-only', '--diff-filter=ACMR', '-z']).split(b'\0')
bad = []
for name in paths:
    if name:
        size = int(subprocess.check_output(['git', 'cat-file', '-s', b':' + name]))
        if size > 20000:
            bad.append((name.decode(), size))
if bad:
    print('Split staged files by responsibility; maximum 20,000 bytes (5,000 estimated tokens):', bad)
    sys.exit(1)
